{
	admin off
	email dubaonongsan@gmail.com
	servers {
		max_header_size 16KB
		timeouts {
			read_body 30s
			read_header 10s
			write 30s
			idle 120s
		}
	}
}

{$FRONTEND_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.dubaonongsan.com https://www.google-analytics.com https://region1.google-analytics.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
		-Server
	}

	handle /sitemap.xml {
		rewrite * /api/v1/sitemap.xml
		reverse_proxy api:8010 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
		header Cache-Control "public, max-age=300, must-revalidate"
		header X-Robots-Tag "index, follow"
	}

	handle /api/* {
		reverse_proxy api:8010 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /assets/* {
		root * /var/www/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /var/www/frontend

		@seoHome {
			path /
		}
		rewrite @seoHome /seo/home.html

		@seoNewsIndex {
			path /tin-tuc
		}
		rewrite @seoNewsIndex /seo/news.html

		@seoGuidesIndex {
			path /huong-dan
		}
		rewrite @seoGuidesIndex /seo/guides.html

		@seoFertilizer {
			path /khuyen-nghi-bon-phan
		}
		rewrite @seoFertilizer /seo/fertilizer.html

		@seoNewsViews path_regexp seoNewsViews ^/tin-tuc/(gia-sau-rieng|gia-ca-phe|gia-ho-tieu)$
		rewrite @seoNewsViews /seo/news-views/{re.seoNewsViews.1}.html

		@seoNews path_regexp seoNews ^/tin-tuc/([^/]+)$
		rewrite @seoNews /seo/news/{re.seoNews.1}.html

		@seoGuides path_regexp seoGuides ^/huong-dan/([^/]+)$
		rewrite @seoGuides /seo/guides/{re.seoGuides.1}.html

		@seoForecast path_regexp seoForecast ^/du-bao-gia/([^/]+)$
		rewrite @seoForecast /seo/forecast/{re.seoForecast.1}.html

		@seoMethodology {
			path /thuat-toan-du-bao
		}
		rewrite @seoMethodology /seo/methodology.html

		@seoFertilizerMethodology {
			path /thuat-toan-bon-phan /khuyen-nghi-bon-phan/logic
		}
		rewrite @seoFertilizerMethodology /seo/fertilizer-methodology.html

		@html {
			path *.html
		}
		header @html Cache-Control "public, max-age=300, must-revalidate"

		@images {
			path *.jpg *.jpeg *.png *.webp *.svg
		}
		header @images Cache-Control "public, max-age=604800"

		try_files {path} /index.html
		file_server
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 5MB
	}

	@apiDocs {
		path /docs /redoc /openapi.json
	}
	respond @apiDocs 404

	reverse_proxy api:8010 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
		-X-Powered-By
	}

	log {
		output file /var/log/caddy/api.log {
			roll_size 100MB
			roll_keep 7
		}
		format json
		level INFO
	}
}
