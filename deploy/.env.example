POSTGRES_DB=marketai
POSTGRES_USER=marketai
POSTGRES_PASSWORD=change-this-long-random-database-password
FRONTEND_DOMAIN=dubaonongsan.com,www.dubaonongsan.com
API_DOMAIN=api.dubaonongsan.com
# Optional offsite database backup via rclone. Example remote: marketai-r2:dubaonongsan/postgres
BACKUP_RCLONE_REMOTE=
# Base64-encoded rclone.conf. Leave empty to use the image/container default config.
BACKUP_RCLONE_CONFIG_B64=
# Optional direct Cloudflare R2 backup config. Prefer bucket-scoped read/write keys.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=dubaonongsan-backups
MARKETAI_BACKUP_REMOTE=
# Optional Sentry release wiring for docker-compose environment.
SENTRY_DSN_BACKEND=
MARKETAI_RELEASE=
