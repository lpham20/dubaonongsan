MARKETAI_DATABASE_URL=postgresql+psycopg://marketai:marketai@localhost:5432/marketai
MARKETAI_ENVIRONMENT=development
MARKETAI_AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
MARKETAI_AUTH_TOKEN_MINUTES=10080
MARKETAI_PUBLIC_API_KEY=replace-with-a-public-api-key
MARKETAI_IOT_API_KEY=replace-with-an-iot-api-key
MARKETAI_SEED_ON_STARTUP=true
MARKETAI_CREATE_DEMO_USER=false
MARKETAI_START_SCHEDULER_IN_API=true
MARKETAI_SCRAPE_INTERVAL_MINUTES=1440
MARKETAI_NEWS_SCRAPE_INTERVAL_MINUTES=180
MARKETAI_NEWS_SCRAPE_DAILY_HOUR=7
MARKETAI_NEWS_SCRAPE_DAILY_MINUTE=0
MARKETAI_DATA_QUALITY_INTERVAL_MINUTES=1440
MARKETAI_RETRAIN_INTERVAL_MINUTES=1440
MARKETAI_JOB_LOCK_DIR=.job_locks
# Optional official daily Urea history from Trading Economics (requires an API subscription/key).
MARKETAI_TRADING_ECONOMICS_API_KEY=
MARKETAI_TRADING_ECONOMICS_UREA_BACKFILL_START=2019-01-01
# Optional Yahoo Finance backfill for CME Urea FOB Middle East continuous daily history.
# Stored for training/backfill; not enabled in default scheduled world-fertilizer scrape.
MARKETAI_YAHOO_UREA_SYMBOL=UME=F
MARKETAI_YAHOO_UREA_RANGE=5y
