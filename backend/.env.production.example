MARKETAI_ENVIRONMENT=production
MARKETAI_AUTH_TOKEN_SECRET=change-this-64-character-random-secret-before-production
MARKETAI_AUTH_PREVIOUS_TOKEN_SECRETS=
MARKETAI_AUTH_TOKEN_MINUTES=10080
MARKETAI_PUBLIC_API_KEY=change-this-public-api-key-before-production
MARKETAI_IOT_API_KEY=change-this-iot-api-key-before-production
MARKETAI_SEED_ON_STARTUP=false
MARKETAI_CREATE_DEMO_USER=false
MARKETAI_START_SCHEDULER_IN_API=false
MARKETAI_CORS_ORIGINS=["https://dubaonongsan.com","https://www.dubaonongsan.com"]
MARKETAI_SCRAPE_INTERVAL_MINUTES=1440
MARKETAI_NEWS_SCRAPE_INTERVAL_MINUTES=180
MARKETAI_NEWS_SCRAPE_DAILY_HOUR=7
MARKETAI_NEWS_SCRAPE_DAILY_MINUTE=0
MARKETAI_DATA_QUALITY_INTERVAL_MINUTES=1440
MARKETAI_RETRAIN_INTERVAL_MINUTES=1440
MARKETAI_JOB_LOCK_DIR=/app/.job_locks
MARKETAI_SENTRY_DSN=
MARKETAI_OPS_ALERT_WEBHOOK_URL=
MARKETAI_OPS_ALERT_TIMEOUT_SECONDS=2
MARKETAI_TURNSTILE_SECRET_KEY=
